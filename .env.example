# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-your-api-key-here

# Otros proveedores (opcionales, según el modelo que uses)
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-v1-...

# API HTTP (make dev): token opcional para POST /analizar.
# Si está definido, la petición debe llevar la cabecera X-API-Token con este valor.
# Sin definir, la API queda abierta — cómodo en localhost, imprudente con `make dev-public`.
# RESIDENCIAFISCAL_API_TOKEN=cambia-esto-por-algo-aleatorio

# Sentry backend (FastAPI). El DSN identifica el proyecto; no es un token de API.
SENTRY_ENABLED=false
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry frontend (Vite/React). Toda variable VITE_* es pública en el bundle.
SENTRY_FRONTEND_DSN=
SENTRY_FRONTEND_PROJECT_SLUG=residencia-fiscal-frontend
VITE_SENTRY_DSN=${SENTRY_FRONTEND_DSN}
VITE_SENTRY_ENABLED=true
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Solo para subir sourcemaps en builds de producción. Nunca lleva prefijo VITE_.
SENTRY_ORG_SLUG=
SENTRY_AUTH_TOKEN=

# Optional: Custom input/output paths
# INPUT_DIR=./pdfs
# OUTPUT_DIR=./output
