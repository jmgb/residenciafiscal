# Proveedores del chat y de experimentos conversacionales.
# No se usan para preparar ni analizar sentencias.
OPENAI_API_KEY=sk-proj-your-api-key-here

# Otros proveedores (opcionales, según el modelo que uses)
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-v1-...

# Chat online comparativo. Cerrado por defecto: estas variables NO analizan PDF
# ni preparan el corpus; solo responden preguntas del usuario.
GEMINI_API_KEY=your-gemini-api-key-here
CHAT_COMPARISON_ENABLED=false
# Overrides independientes bajo el interruptor maestro. Si se omiten y el
# maestro está en `true`, se mantienen activas A y B por compatibilidad.
# CHAT_STRATEGY_A_ENABLED=true
# CHAT_STRATEGY_B_ENABLED=true
CHAT_FILE_SEARCH_MODEL=gemini-3.5-flash-lite
CHAT_FILE_SEARCH_STORE_NAME=fileSearchStores/your-store-name
# Deadline interno: debe dejar margen antes del límite sincrónico de 60 s.
CHAT_DEADLINE_MS=52000
# Persistencia privada de mensajes y costes. La secret key solo
# vive en Functions; nunca debe llevar prefijo VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-key
# Administración local de migraciones; no configurar en el runtime de Netlify.
SUPABASE_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token
SUPABASE_DB_PASSWORD=your-database-password
# Retención aprobada del dato conversacional. Obligatoria para instalar el
# timer de purgado; no rellenar hasta cerrar la decisión legal.
# CHAT_RETENTION_DAYS=30
# Guardarraíles del job: desactivado y en dry-run por defecto. Activar solo
# después de aprobar la política y observar primero el dry-run.
# CHAT_RETENTION_PURGE_ENABLED=false
# CHAT_RETENTION_DRY_RUN=true
# CHAT_RETENTION_BATCH_LIMIT=500
# Retención de snapshots R2. Si se omite, sigue CHAT_RETENTION_DAYS; sin ambos,
# el backup conserva el fallback histórico de 30 días.
# BACKUP_RETENTION_DAYS=30
# CHAT_RETRIEVAL_CORPUS=/absolute/path/to/corpus.json
# CHAT_FILE_SEARCH_STORE_STATE=/absolute/path/to/rollout-106-store.json
# CHAT_COMPARISON_OUTPUT_DIR=/persistent/path/chat-comparisons
# CHAT_COMPARISON_LOG=/persistent/path/chat-strategy-comparison.jsonl

# Prototipo FastAPI conservado para una arquitectura futura de llamadas de más
# de 60 s; no interviene en la V1 Netlify-only.
# CHAT_PROXY_SECRET=generate-a-long-random-secret
# CHAT_BACKEND_URL=https://api.example.com

# Selector del frontend (scope Builds). Solo `live` activa el endpoint; cualquier
# otro valor conserva el stub. Mantener `stub` en producción hasta superar gates.
VITE_CHAT_MODE=stub
# Límite blando del navegador: mensajes por ventana móvil de 24 horas y sesión.
VITE_CHAT_SESSION_MESSAGE_LIMIT=10

# Opción C asíncrona. Cerrada por defecto hasta completar C2/C3/C6.
# VITE_DEEP_RESEARCH_ENABLED=false
# DEEP_RESEARCH_ENABLED=false
# ALFREDO_JOBS_URL=https://alfredo-agent.example/jobs
# ALFREDO_HMAC_SECRET=generate-a-long-random-secret
# DEEP_RESEARCH_CALLBACK_URL=https://residenciafiscal.org/api/deep-research-callback
# DEEP_RESEARCH_BUNDLE_ID=rollout-106/2

# Sentry backend (FastAPI). El DSN identifica el proyecto; no es un token de API.
SENTRY_ENABLED=false
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry frontend (Vite/React). Toda variable VITE_* es pública en el bundle.
SENTRY_FRONTEND_DSN=
SENTRY_FRONTEND_PROJECT_SLUG=residencia-fiscal-frontend
VITE_SENTRY_DSN=${SENTRY_FRONTEND_DSN}
VITE_SENTRY_ENABLED=true
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry de la Netlify Function del chat (proyecto propio `residencia-fiscal-chat`).
# En Netlify van como variables ordinarias de `production`: la cuenta Legacy no
# admite scope Functions. Sin prefijo VITE_: es runtime de servidor.
# A Sentry solo llega un evento sintético con código de fallo y etapa; nunca la
# pregunta, la respuesta ni el mensaje de excepción del proveedor.
CHAT_SENTRY_ENABLED=false
CHAT_SENTRY_DSN=

# Solo para subir sourcemaps en builds de producción. Nunca lleva prefijo VITE_.
SENTRY_ORG_SLUG=
SENTRY_TOKEN=

# Search Console: propiedad por defecto del skill google-search-console.
GSC_SITE_URL=sc-domain:residenciafiscal.org

# Resumen diario del ledger del chat por Telegram (timer del VPS). El umbral
# solo destaca el mensaje: el coste observado no gobierna ninguna cuota.
DAILY_CHAT_COST_TELEGRAM_ENABLED=true
CHAT_DAILY_COST_ALERT_USD=1.00

# UptimeRobot: monitorización externa del frontend (docs/operations/UPTIMEROBOT.md).
# La clave es de cuenta (prefijo u...) y solo se usa a mano; el sitio no la lee.
UPTIMEROBOT_API_KEY=
UPTIMEROBOT_ALERT_EMAIL=

# Informe semanal de tráfico por Telegram (docs/operations/WEEKLY_TRAFFIC_REPORT.md).
# Lo lee scripts/weekly_ga4_telegram.py; el sitio no usa ninguna de estas claves.
WEEKLY_GA4_TELEGRAM_ENABLED=true
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# PostHog: fuente activa del informe. PROJECT_ID es el numérico del proyecto y
# PERSONAL_API_KEY (prefijo phx_) es una clave personal con permiso de lectura.
POSTHOG_QUERY_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_TRAFFIC_HOST=residenciafiscal.org
# GA4: opcional. Sin GA4_PROPERTY_ID el informe se queda solo en PostHog.
# GA4_PROPERTY_ID=
# GOOGLE_APPLICATION_CREDENTIALS=credentials/ga4.json

# Optional: Custom input/output paths
# INPUT_DIR=./pdfs
# OUTPUT_DIR=./output
