[Unit]
Description=Residencia Fiscal - Check de frescura del backup en R2
Documentation=file:///home/ubuntu/residenciafiscal/docs/operations/BACKUPS.md
After=network-online.target
Wants=network-online.target
OnFailure=residenciafiscal-backup-failure@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/residenciafiscal
ExecStart=/bin/bash /home/ubuntu/residenciafiscal/scripts/backup/check-backup-freshness.sh
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=residenciafiscal-backup-freshness
