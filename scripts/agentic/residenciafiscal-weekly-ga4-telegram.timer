[Unit]
Description=Send the Residencia Fiscal traffic digest every Monday at 09:10 (Europe/Madrid)

[Timer]
# Escalonado por proyecto: cinco digests a la misma hora mezclan sus logs y
# compiten por la cuota de la API de GA4.
OnCalendar=Mon *-*-* 09:10:00 Europe/Madrid
Persistent=true
AccuracySec=1min
Unit=residenciafiscal-weekly-ga4-telegram.service

[Install]
WantedBy=timers.target
