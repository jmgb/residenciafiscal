[Unit]
Description=Residencia Fiscal daily chat digest freshness guard
# No toca la red salvo para mandar la alerta: sin frescura que declarar, calla.
Wants=network-online.target
After=network-online.target
# Tras un apagón, `Persistent=true` dispara los dos timers a la vez al arrancar
# y la hora del `OnCalendar` deja de separarlos: sin este orden el guardián leía
# el estado mientras el digest todavía estaba poniéndolo al día y alertaba de un
# desfase que se cerraba un segundo después. No es `Wants=`: el guardián vigila
# que el digest corra, no lo arranca él, o dejaría de poder detectar su ausencia.
After=residenciafiscal-daily-chat-cost-telegram.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/ai_projects/residenciafiscal
# Con el intérprete del sistema, igual que el aviso de fallo del digest: un
# entorno de `uv` roto no puede silenciar al guardián que vigila el silencio.
ExecStart=/usr/bin/python3 /home/ubuntu/ai_projects/residenciafiscal/scripts/check_daily_chat_cost_freshness.py
# Peor caso: consultar systemd y mandar una alerta por Telegram.
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
