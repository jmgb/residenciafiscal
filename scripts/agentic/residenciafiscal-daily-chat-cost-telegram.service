[Unit]
Description=Residencia Fiscal daily chat ledger Telegram digest
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/ai_projects/residenciafiscal
ExecStart=/bin/bash /home/ubuntu/ai_projects/residenciafiscal/scripts/agentic/daily_chat_cost_telegram_runner.sh
# Cubre el peor caso de `--catch-up`: siete días, cada uno con su timeout de
# RPC y de Telegram, más el aviso de días omitidos. Con 300 s systemd mataba el
# job a mitad, sin avanzar el estado y sin dejar salir la alerta de fallo.
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
