# Environment
# `.env.*` con negación explícita para el ejemplo. El patrón anterior
# (.env.local + .env.*.local) dejaba fuera .env.production, .env.development,
# .env.backup y .env.old, que sí llevan valores reales.
.env
.env.*
!.env.example
venv/
env/
ENV/
.venv/

# uv (uv.lock SÍ se versiona)
.uv-cache/
.uv_cache/

# Local agent/workspace state
.serena/
.codex/
.claude/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anclados a la raíz: sin la barra inicial también capturaban
# frontend/src/lib/, que es código fuente.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# Testing
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage/
htmlcov/
.tox/
.hypothesis/
*.cover
*.tsbuildinfo

# Output directories (generated files)
output/*
!output/.gitkeep
results/
test_output/
test/test_outputs/
test_results/

# PDFs (keep sentencias/ but ignore generated output)
pdfs/

# Temporary/analysis files
informe.txt
*.tmp

# OS
.DS_Store
Thumbs.db
*.log

# Temporary
*.tmp
*.bak
*.swp
*~

# Node (el frontend tiene su propio .gitignore; esto cubre la raíz)
node_modules/

# Tool caches and process state
.cache/
.vite/
*.pid
*.seed

# Symlink a doc personal fuera del repo
SUPABASE_ACCOUNTS.md

# MCP local config (puede contener secretos) - no versionar
.mcp.json
.mcp.json.template

# Compañero visual de brainstorming (superpowers)
.superpowers/

# Specs y planes de implementación internos: citan rutas y decisiones de otros
# proyectos privados, así que no se publican. Se conservan en local.
docs/superpowers/
