{
  "name": "residenciafiscal-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "residenciafiscal.org - Chatbot sobre jurisprudencia de residencia fiscal (Art. 9 LIRPF)",
  "scripts": {
    "dev": "vite",
    "build:chat-artifacts": "node scripts/build-chat-verbatim-artifacts.mjs",
    "build:judgment-pdfs": "node scripts/build-judgment-pdfs.mjs",
    "prebuild": "npm run build:chat-artifacts && npm run build:judgment-pdfs && node scripts/build-corpus.mjs && node scripts/build-normativa.mjs && node scripts/build-sentencias.mjs && node scripts/build-sitemap.mjs && node scripts/build-netlify-redirects.mjs",
    "build": "tsc --noEmit && vite build",
    "postbuild": "npm run build:ssr && node scripts/inject-font-preload.mjs && node scripts/prerender.mjs && node scripts/build-version.mjs",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "og": "bash og/render.sh",
    "favicon": "bash og/render-favicon.sh",
    "fast-check": "npm run lint && npm run typecheck && npm run test",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@google/genai": "2.15.0",
    "@netlify/blobs": "10.7.11",
    "@netlify/functions": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@sentry/react": "10.68.0",
    "@supabase/supabase-js": "2.111.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.27.0",
    "openai": "7.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "8.3.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@netlify/edge-functions": "3.0.8",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
